{
  "name": "@cutils/cli",
  "version": "0.6.0",
  "description": "Type-first declarative CLI builder in the scriptc compilable subset — commands, typed options, generated help, compiles into the app's single static ELF",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sigilco/cutils.git",
    "directory": "packages/cli"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "main": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js"
    },
    "./package.json": "./package.json",
    "./elf": "./dist/esm/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.js test/*.test.mjs && bash test/elf.test.sh && bash test/consumer-elf.test.sh"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22"
  },
  "author": "Joaquin Terrasa & contributors",
  "keywords": [
    "cli",
    "argv",
    "commander",
    "argparse",
    "scriptc",
    "native"
  ],
  "homepage": "https://github.com/sigilco/cutils/tree/main/packages/cli#readme",
  "bugs": {
    "url": "https://github.com/sigilco/cutils/issues"
  },
  "sideEffects": false
}
