{
  "name": "@chttp/cache",
  "version": "0.2.0",
  "description": "Map-based LRU+TTL memory cache with lru-cache-parity semantics, authored inside the scriptc compilable subset",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sigilco/cutils.git",
    "directory": "packages/cache"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "main": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.js test/*.test.mjs && bash test/elf.test.sh"
  },
  "devDependencies": {
    "@chttp/router": "^0.2.1",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22"
  },
  "author": "Joaquin Terrasa & contributors",
  "keywords": [
    "cache",
    "lru",
    "ttl",
    "memory-cache",
    "lru-cache",
    "scriptc",
    "native"
  ],
  "homepage": "https://github.com/sigilco/cutils/tree/main/packages/cache#readme",
  "bugs": {
    "url": "https://github.com/sigilco/cutils/issues"
  },
  "sideEffects": false
}
